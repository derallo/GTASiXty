<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="horizonos.permission.USB_CAMERA" />
    <!-- Normal permission: lets us clear background apps so they stop competing for the
         compositor/GPU/decoder while streaming. It cannot kill foreground apps. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Android 11+ hides other packages unless we ask to see them; needed to enumerate the
         third-party apps whose background processes we clear before streaming. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Quest 3 optical hand tracking: drives the GTA V hands + auto-spawning Xbox controller.
         XR_EXT_hand_tracking also gives us all 26 joints/validity flags/radii via
         src/main/cpp/hand_tracker_jni.cpp, which works even while Meta's translucent hand meshes are
         hidden (avatarSystem.setShowHands(false)).

         DO NOT add com.oculus.permission.BODY_TRACKING or oculus.software.body_tracking here.
         Declaring body tracking is what Horizon OS keys off to put the app in *body* tracking mode,
         and in that mode the runtime never delivers XR_EXT_hand_tracking joints (every
         xrLocateHandJointsEXT call returns isActive=false with all-invalid joints, in every reference
         space). Removing them is what makes hand tracking activate. -->
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1" />
    <uses-feature
        android:name="com.oculus.feature.PASSTHROUGH"
        android:required="false" />
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.external"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="GTA-Sixty">

        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />
        <meta-data
            android:name="com.oculus.vr.focusaware"
            android:value="true" />
        <!-- HIGH frequency = 60 Hz hand joint updates from the runtime (needed for 120 Hz hands
             with no visible lag behind the real controller). -->
        <meta-data
            android:name="com.oculus.handtracking.frequency"
            android:value="HIGH" />
        <meta-data
            android:name="com.oculus.handtracking.version"
            android:value="V2.0" />

        <activity
            android:name=".SpatialMainActivity"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GtaSixty.Spatial">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:allowEmbedded="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection"
            android:exported="false"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GtaSixty.Panel" />

        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.gtasixty.spatial.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
